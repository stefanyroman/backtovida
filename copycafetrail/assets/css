body {
    font-family: Arial, sans-serif;
    margin: 0;
    background: #f7f5f2;
}

/* HEADER */
.header {
    background: white;
    padding: 20px;
    text-align: center;
    border-bottom: 1px solid #ddd;
}

.header h1 {
    margin: 0;
    font-size: 28px;
}

/* CATEGORY BAR */
.categories {
    display: flex;
    justify-content: center;
    gap: 10px;
    padding: 15px;
    background: white;
    border-bottom: 1px solid #ddd;
}

.categories button {
    padding: 8px 16px;
    border: 1px solid #ccc;
    background: white;
    cursor: pointer;
    border-radius: 20px;
}

.categories .active {
    background: #6b4f3b; /* brown */
    color: white;
    border: none;
}

/* PRODUCT GRID */
.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    padding: 20px;
}

/* CARD */
.card {
    background: white;
    border-radius: 10px;
    padding: 15px;
    text-align: center;
    transition: 0.2s;
}

.card:hover {
    transform: translateY(-3px);
}

/* IMAGE PLACEHOLDER */
.image {
    height: 180px;
    background: #ddd;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    border-radius: 8px;
    margin-bottom: 10px;
}

/* TEXT */
.card h3 {
    margin: 10px 0 5px;
}

.card p {
    margin: 0;
    color: #555;
}

/* BUTTON */
.card button {
    margin-top: 10px;
    padding: 10px;
    width: 100%;
    background: #6b4f3b; /* brown */
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.card button:hover {
    background: #5a3f2f;
}